<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle identity. With GENERATE_INFOPLIST_FILE = NO, Xcode does NOT inject these, so the
	     $(...) build-setting variables (set in project.yml) are expanded in here at build time. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleName</key>
	<string>Gracia</string>
	<key>CFBundleDisplayName</key>
	<string>Gracia</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- UIScene lifecycle: one window scene, driven by SceneDelegate. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- ARKit needs camera access; iOS refuses the session without this string. -->
	<key>NSCameraUsageDescription</key>
	<string>The camera feed is used to place and view Gaussian-splat scenes in augmented reality.</string>
	<!-- Empty dict = a plain black launch screen, so the app runs full-screen with no storyboard. -->
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Portrait-locked keeps the ARKit orientation math to a single case; the viewer is happy in it too. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- A portrait-only app must declare full-screen, or iPad multitasking demands every orientation. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- Lets an MTKView run past 60 Hz on a ProMotion display. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
</dict>
</plist>
